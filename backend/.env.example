# VIVA Backend Configuration Template
# Copy this file to backend/.env and fill in your own values.
# Never commit backend/.env or share real credentials.

PORT=4000
CLIENT_URL=http://localhost:8443
MONGO_URI=mongodb://127.0.0.1:27017/viva_interview
JWT_SECRET=your_jwt_secret_here

# Keep GROQ_API_KEY configured for the existing Whisper transcription endpoint.
# Set it to the same value as GROQ_QUESTION_API_KEYS primary key unless you use a separate transcription key.
GROQ_API_KEY=your_groq_api_key_here

# Two-key pool for evaluating normal, coding, and SQL answers.
GROQ_EVALUATION_API_KEYS=your_evaluation_key_1,your_evaluation_key_2

# Two-key pool for ALL interview question generation, including personalized, role, coding, and SQL questions.
GROQ_QUESTION_API_KEYS=your_question_key_1,your_question_key_2

# Fifth key is reserved ONLY for ATS resume scoring (/analyze-resume), not interview resume-summary generation.
GROQ_ATS_API_KEY=your_dedicated_ats_key_here

# Ordered model fallback pool. Confirm model access in your Groq account.
INTERVIEW_LLM_MODEL=openai/gpt-oss-120b
INTERVIEW_LLM_FALLBACK_MODEL=openai/gpt-oss-20b
INTERVIEW_LLM_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
INTERVIEW_MODEL_COOLDOWN_SECONDS=300
INTERVIEW_AGENT_PORT=5100
INTERVIEW_AGENT_URL=http://127.0.0.1:5100
PYTHON_BIN=python
RAG_EMBED_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_MAX_PAGES=4
RAG_CHUNK_WORDS=180
RAG_MAX_CONTEXT_CHARS=14000

# Optional: set false to disable the proctor service.
START_PROCTOR=true
START_INTERVIEW_AGENT=true
